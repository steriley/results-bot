---
import Header from './Header.astro';
import PageTitle from './PageTitle.astro';
import Sidebar from './Sidebar.astro';

interface Props {
  pageTitle: string;
  pageSubtitle: string;
}

const { pageTitle, pageSubtitle } = Astro.props;
---

<Sidebar />
<!-- Main Content Area -->
<main class="flex-1 flex flex-col h-screen min-w-0 overflow-hidden relative">
  <Header />
  <!-- Viewport -->
  <div
    class="flex-1 overflow-y-auto custom-scrollbar p-4 md:p-8 bg-slate-50 dark:bg-background-dark"
  >
    <div class="max-w-5xl mx-auto space-y-6 md:space-y-8">
      <PageTitle title={pageTitle} subtitle={pageSubtitle}>
        <slot name="titleActions" />
      </PageTitle>
      <slot />
    </div>
  </div>
</main>
