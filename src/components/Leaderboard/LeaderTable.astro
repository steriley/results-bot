---
import LeaderRow from '@/components/Leaderboard/LeaderRow.astro';
import { getLeagueTable } from '@/db/services/LeagueTable.service';

const { user } = Astro.locals;
const table = await getLeagueTable({ timeFilter: 'all-time', sortBy: 'totalPoints' });

const currentUserId = user?.id ?? null;
---

<div
  class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-200 dark:border-border-dark mb-6 gap-4"
>
  <div class="flex gap-8 overflow-x-auto no-scrollbar">
    <button
      type="button"
      class="border-b-2 border-primary text-primary font-bold text-sm pb-4 px-2 whitespace-nowrap"
    >
      Weekly
    </button>
    <button
      type="button"
      class="border-b-2 border-transparent text-slate-500 dark:text-slate-400 font-bold text-sm pb-4 px-2 hover:text-slate-700 dark:hover:text-slate-200 transition-colors whitespace-nowrap"
    >
      Monthly
    </button>
    <button
      type="button"
      class="border-b-2 border-transparent text-slate-500 dark:text-slate-400 font-bold text-sm pb-4 px-2 hover:text-slate-700 dark:hover:text-slate-200 transition-colors whitespace-nowrap"
    >
      All-Time
    </button>
  </div>
  <div class="flex items-center gap-2 pb-2">
    <span class="text-slate-500 text-xs font-bold uppercase tracking-widest">Sort By:</span>
    <select
      class="bg-transparent border-none text-slate-900 dark:text-white text-sm font-bold focus:ring-0 cursor-pointer py-0"
    >
      <option>Total Points</option>
      <option>Accuracy %</option>
      <option>Correct Scores</option>
    </select>
  </div>
</div>
<!-- Leaderboard Table Container -->
<div
  class="bg-white dark:bg-surface-dark rounded-xl border border-slate-200 dark:border-border-dark overflow-hidden shadow-sm"
>
  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr
          class="bg-slate-50 dark:bg-background-dark border-b border-slate-200 dark:border-border-dark"
        >
          <th
            class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400"
          >
            Rank
          </th>
          <th
            class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400"
          >
            Player
          </th>
          <th
            class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 text-center"
          >
            Played
          </th>
          <th
            class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 text-center"
          >
            Correct Result
          </th>
          <th
            class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 text-center"
          >
            Correct Score
          </th>
          <th
            class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 text-right"
          >
            Total Points
          </th>
          <th class="px-6 py-4"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-border-dark">
        {table.map(({ userId, userName, played, correctResults, correctScores, totalPoints }, rank) => {
          const isBot = userId === '666';
          const isUser = userId === currentUserId;
          return <LeaderRow rank={rank + 1} isBot={isBot} isUser={isUser} userName={userName} played={played} correctResults={correctResults} correctScores={correctScores} totalPoints={totalPoints} />
        })}
      </tbody>
    </table>
  </div>
</div>
