---
const { title, icon, value, trend, trendValue } = Astro.props;

const trendIcon = trend === 'up' ? 'trending_up' : 'trending_down';
const trendColor = trend === 'up' ? 'text-emerald-500' : 'text-red-500';
---

<div
  class="flex flex-col gap-2 rounded-xl p-6 bg-white dark:bg-surface-dark border border-slate-200 dark:border-border-dark shadow-sm"
>
  <div class="flex justify-between items-center">
    <p class="text-slate-500 dark:text-slate-400 text-sm font-medium">{title}</p>
    <span class="material-symbols-outlined text-slate-400">{icon}</span>
  </div>
  <div class="flex items-baseline gap-2">
    <p class="text-slate-900 dark:text-white text-3xl font-bold">{value}</p>
    {trend &&
    <span class:list={[trendColor, 'text-sm font-bold flex items-center']}>
      <span class="material-symbols-outlined text-sm">{trendIcon}</span>
      {trendValue}
    </span>}
  </div>
</div>
