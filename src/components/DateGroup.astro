---
import type { Game } from '../types/game';
import { getTeamLogo } from '../helpers/team-logos';

interface Props {
  date: string;
  games: Game[];
  showAIPredict?: boolean;
  showUserInputs?: boolean;
}

const {
  date,
  games,
  showAIPredict = true,
  showUserInputs = false,
} = Astro.props as Props;

function formatTime(commenceTime: string): string {
  const time = new Date(commenceTime);
  return time.toLocaleTimeString('en-GB', {
    hour: '2-digit',
    minute: '2-digit',
  });
}
---

<section class="space-y-3">
  <div
    class="sticky top-0 z-10 py-2 bg-slate-50 dark:bg-background-dark flex items-center gap-3"
  >
    <h4 class="text-sm font-bold uppercase tracking-widest text-primary">
      {date}
    </h4>
    <div class="flex-1 h-px bg-slate-200 dark:bg-border-dark"></div>
  </div>
  <div
    class="bg-white dark:bg-surface-dark border border-slate-200 dark:border-border-dark rounded-xl shadow-sm overflow-hidden divide-y divide-slate-100 dark:divide-border-dark"
  >
    {
      games.map((game) => (
        <div class="flex flex-col lg:flex-row lg:items-center p-4 gap-4 fixture-row transition-colors">
          <div class="w-16 flex flex-col items-center justify-center lg:border-r lg:border-slate-100 dark:lg:border-border-dark">
            <span class="text-sm font-bold">
              {formatTime(game.commenceTime)}
            </span>
            <span class="text-[10px] text-muted-dark font-medium uppercase">
              GMT
            </span>
          </div>
          <div class="flex-1 flex items-center justify-between px-2">
            <div class="flex items-center gap-3 w-1/3 justify-end text-right">
              <span class="text-sm md:text-base font-bold truncate">
                {game.homeTeam}
              </span>
              {getTeamLogo(game.homeTeam) && (
                <img
                  src={getTeamLogo(game.homeTeam)}
                  alt={game.homeTeam}
                  class="w-8 h-8 flex-shrink-0"
                />
              )}
              {showUserInputs && (
                <input
                  type="number"
                  min="0"
                  max="20"
                  class="w-12 h-10 text-center text-xl border-none focus:ring-0 text-slate-900 dark:text-white font-bold p-0 bg-slate-200 dark:bg-border-dark rounded-lg"
                  data-game-id={game.gameId}
                  data-side="home"
                  aria-label={`${game.homeTeam} score`}
                />
              )}
            </div>
            <div class="px-4 text-xs font-black text-muted-dark tracking-widest">
              VS
            </div>
            <div class="flex items-center gap-3 w-1/3">
              {showUserInputs && (
                <input
                  type="number"
                  min="0"
                  max="20"
                  class="w-12 h-10 text-center text-xl border-none focus:ring-0 text-slate-900 dark:text-white font-bold p-0 bg-slate-200 dark:bg-border-dark rounded-lg"
                  data-game-id={game.gameId}
                  data-side="away"
                  aria-label={`${game.awayTeam} score`}
                />
              )}
              {getTeamLogo(game.awayTeam) && (
                <img
                  src={getTeamLogo(game.awayTeam)}
                  alt={game.awayTeam}
                  class="w-8 h-8 flex-shrink-0"
                />
              )}
              <span class="text-sm md:text-base font-bold truncate">
                {game.awayTeam}
              </span>
            </div>
          </div>
          <div class="flex items-center gap-2 lg:ml-auto">
            {showAIPredict && (
              <div class="flex flex-col items-center justify-center bg-primary/10 border border-primary/30 rounded-lg px-4 py-2 min-w-[100px]">
                <span class="text-[9px] uppercase font-bold text-secondary tracking-tighter">
                  AI Predict {Math.round(game.confidence * 100)}%
                </span>
                <span class="text-lg font-black text-secondary leading-none">
                  {game.mostLikelyScore.home} - {game.mostLikelyScore.away}
                </span>
              </div>
            )}

            {game.trapWarning && (
              <div
                class="w-8 h-8 flex items-center justify-center rounded-lg bg-yellow-100 dark:bg-yellow-900/30 border border-yellow-300 dark:border-yellow-700"
                title="Trap warning: Exercise caution"
              >
                <span class="material-symbols-outlined text-xs text-yellow-600 dark:text-yellow-400">
                  warning
                </span>
              </div>
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .material-symbols-outlined {
    font-variation-settings:
      'FILL' 0,
      'wght' 400,
      'GRAD' 0,
      'opsz' 24;
  }
  .active-tab {
    background-color: #101622;
    color: white;
    box-shadow: 0 0 4px rgba(0, 0, 0, 0.1);
  }
  input::-webkit-outer-spin-button,
  input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
</style>
