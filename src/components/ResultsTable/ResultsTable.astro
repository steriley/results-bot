---
import DateGroup from '@/components/ResultsTable/DateGroup.astro';
import TableDate from '@/components/ResultsTable/TableDate.vue';
import TotalPoints from '@/components/ResultsTable/TotalPoints.astro';
import type { EnrichedFixture } from '@/helpers/merge-fixtures-predictions';
import { fixtureByDates, fixtureDates } from '@/helpers/sort-games-by-date';

interface Props {
  fixtures: EnrichedFixture[];
}

const { fixtures } = Astro.props as Props;

const fixturesByDate = fixtureByDates(fixtures);
const sortedFixtures = fixtureDates(fixturesByDate);
---

<div class="space-y-6 pb-20">
  {sortedFixtures.map((date) => (
      <section class="space-y-3">
        <TableDate date={date} client:load />
        <DateGroup games={fixturesByDate[date]} />
      </section>
    ))}
  <TotalPoints games={fixturesByDate} />
</div>
