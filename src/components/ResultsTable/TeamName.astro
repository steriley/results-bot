---
import { getTeamLogo } from '@/helpers/team-logos';

interface Props {
  teamName: string;
  awayTeam?: boolean;
}

const { teamName, awayTeam } = Astro.props as Props;
---

<div
  class={`flex gap-1.5 md:gap-3 items-center ${awayTeam ? 'flex-row-reverse' : ''}`}
>
  <span class="text-xs md:text-base font-bold truncate">
    {teamName}
  </span>
  {
    getTeamLogo(teamName) && (
      <span class="w-5 md:w-8 flex items-center justify-center">
        <img
          src={getTeamLogo(teamName)}
          alt={teamName}
          class="h-5 md:h-8 flex-shrink-0"
        />
      </span>
    )
  }
</div>
