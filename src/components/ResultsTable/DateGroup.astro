---
import GameTime from '@/components/ResultsTable/GameTime.astro';
import PointsPill from '@/components/ResultsTable/PointsPill.astro';
import TeamName from '@/components/ResultsTable/TeamName.astro';
import UserInput from '@/components/ResultsTable/UserInput.astro';
import type { EnrichedFixture } from '@/helpers/merge-fixtures-predictions';
import { $gameweekData } from '@/stores/gameweekData';

interface Props {
  games: EnrichedFixture[];
  showAIPredict?: boolean;
  showUserInputs?: boolean;
}

const {
  games,
  showAIPredict = true,
  showUserInputs = false,
} = Astro.props as Props;
---

<div
  class="bg-white dark:bg-surface-dark border border-slate-200 dark:border-border-dark rounded-xl shadow-sm overflow-hidden divide-y divide-slate-100 dark:divide-border-dark"
>
  {
    games.map((game) => {
      const isCompleted = game.finished;
      const { predictedScoreHome, predictedScoreAway, finalScore, points } =
        game;

      return (
        <div class="flex flex-row items-center p-3 md:p-4 gap-2 md:gap-4 fixture-row transition-colors">
          <div class="flex-1 flex flex-row items-center justify-between min-w-0">
            <div class="flex items-center gap-1.5 md:gap-3 flex-1 justify-end text-right min-w-0">
              <TeamName teamName={game.homeTeam} />

              {isCompleted && finalScore ? (
                <div class="w-8 h-8 md:w-12 md:h-10 flex items-center justify-center text-sm md:text-xl font-bold bg-slate-900 dark:bg-black text-white dark:text-white rounded-md md:rounded-lg flex-shrink-0 shadow-sm">
                  {finalScore.homeTeam}
                </div>
              ) : (
                <>
                  {showUserInputs && <UserInput score={predictedScoreHome} />}
                  {!showUserInputs && showAIPredict && (
                    <div class="w-8 h-8 md:w-12 md:h-10 flex items-center justify-center text-sm md:text-xl font-bold bg-slate-200 dark:bg-border-dark text-slate-900 dark:text-white rounded-md md:rounded-lg flex-shrink-0">
                      {predictedScoreHome}
                    </div>
                  )}
                </>
              )}
            </div>

            <div class="px-2 md:px-4 shrink-0 flex flex-col items-center justify-center w-[72px] md:w-[88px]">
              {isCompleted &&
              predictedScoreHome !== undefined &&
              predictedScoreAway !== undefined ? (
                <>
                  <span class="text-xs md:text-sm font-bold whitespace-nowrap text-muted-dark pb-0.5">
                    {predictedScoreHome} - {predictedScoreAway}
                  </span>
                  <span class="text-[9px] md:text-[10px] text-muted-dark font-medium uppercase border-t border-slate-200 dark:border-slate-700 pt-0.5 w-full text-center">
                    PREDICTION
                  </span>
                </>
              ) : (
                <GameTime kickoffTime={game.commenceTime} />
              )}
            </div>

            <div class="flex items-center gap-1.5 md:gap-3 flex-1 min-w-0">
              {isCompleted && finalScore ? (
                <div class="w-8 h-8 md:w-12 md:h-10 flex items-center justify-center text-sm md:text-xl font-bold bg-slate-900 dark:bg-black text-white dark:text-white rounded-md md:rounded-lg flex-shrink-0 shadow-sm">
                  {finalScore.awayTeam}
                </div>
              ) : (
                <>
                  {!showUserInputs && showAIPredict && (
                    <div class="w-8 h-8 md:w-12 md:h-10 flex items-center justify-center text-sm md:text-xl font-bold bg-slate-200 dark:bg-border-dark text-slate-900 dark:text-white rounded-md md:rounded-lg flex-shrink-0">
                      {predictedScoreAway}
                    </div>
                  )}
                  {showUserInputs && <UserInput score={predictedScoreAway} />}
                </>
              )}

              <TeamName teamName={game.awayTeam} awayTeam={true} />
            </div>
          </div>

          <div class="flex items-center justify-start ml-2 md:ml-4 w-16 md:w-20 shrink-0">
            {isCompleted ? (
              <PointsPill score={points.score} type={points.type} />
            ) : (
              <span class="w-full" aria-hidden="true" />
            )}
          </div>
        </div>
      );
    })
  }
</div>
