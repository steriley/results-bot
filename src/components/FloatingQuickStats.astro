---
interface Props {
  accuracy: number;
  trending: 'up' | 'down';
}

const { accuracy, trending } = Astro.props;
---

<!-- Floating Quick Stats (Bottom Right) -->
<div
  class="fixed bottom-6 right-6 flex flex-col items-end gap-3 pointer-events-none"
>
  <div
    class="bg-primary text-white p-4 rounded-xl shadow-2xl shadow-primary/20 flex items-center gap-4 pointer-events-auto"
  >
    <div class="flex flex-col">
      <span class="text-[10px] font-bold uppercase opacity-80 leading-none"
        >Your Prediction Accuracy</span
      >
      <span class="text-2xl font-black">{accuracy.toFixed(1)}%</span>
    </div>
    <div
      class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center"
    >
      <span class="material-symbols-outlined font-bold"
        >trending_{trending}</span
      >
    </div>
  </div>
</div>
