---
import SidebarHeader from './SidebarHeader.astro';
import SidebarFooter from './SidebarFooter.astro';

const navItems = [
  { icon: 'smart_toy', label: 'Results Bot', href: '/' },
  { icon: 'diamond', label: 'My Predictions', href: '/predictions' },
  { icon: 'leaderboard', label: 'Leaderboard', href: '/leaderboard' },
  { icon: 'analytics', label: 'Stats & Insights', href: '/stats' },
];

const currentPath = new URL(Astro.request.url).pathname;
---

<!-- Sidebar Navigation -->
<aside
  id="app-sidebar"
  class="fixed md:relative inset-y-0 left-0 z-50 w-64 md:w-20 lg:w-64 border-r border-slate-200 dark:border-border-dark bg-white dark:bg-background-dark flex flex-col h-screen transition-all duration-300 transform -translate-x-full md:translate-x-0 shrink-0"
>
  <button
    id="desktop-sidebar-toggle"
    class="absolute -right-3 top-8 bg-white dark:bg-surface-dark border border-slate-200 dark:border-border-dark rounded-full w-6 h-6 flex items-center justify-center text-slate-500 hover:text-primary z-50 drop-shadow-sm hidden md:flex cursor-pointer transition-transform"
  >
    <span class="material-symbols-outlined text-[14px]">chevron_left</span>
  </button>

  <SidebarHeader />

  <nav class="flex-1 px-3 space-y-1 mt-4 overflow-y-auto overflow-x-hidden">
    {
      navItems.map((item) => (
        <a
          class={`flex items-center gap-4 px-4 py-3 rounded-lg group whitespace-nowrap ${
            currentPath === item.href
              ? 'bg-primary/10 text-primary'
              : 'text-slate-600 dark:text-muted-dark hover:bg-slate-100 dark:hover:bg-surface-dark transition-colors'
          }`}
          href={item.href}
          title={item.label}
        >
          <span class="material-symbols-outlined shrink-0">{item.icon}</span>
          <span class="sidebar-text font-medium opacity-100 transition-opacity duration-300 origin-left">
            {item.label}
          </span>
        </a>
      ))
    }
  </nav>

  <SidebarFooter />
</aside>

<!-- Mobile Backdrop -->
<div
  id="sidebar-backdrop"
  class="fixed inset-0 bg-slate-900/50 z-40 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
>
</div>

<script>
  function setupSidebar() {
    const sidebar = document.getElementById('app-sidebar');
    const mobileBtn = document.getElementById('mobile-sidebar-toggle');
    const backdrop = document.getElementById('sidebar-backdrop');
    const desktopBtn = document.getElementById('desktop-sidebar-toggle');
    const toggleIcon = desktopBtn?.querySelector('span');

    function openMobile() {
      sidebar?.classList.remove('-translate-x-full');
      backdrop?.classList.remove('opacity-0', 'pointer-events-none');
    }

    function closeMobile() {
      sidebar?.classList.add('-translate-x-full');
      backdrop?.classList.add('opacity-0', 'pointer-events-none');
    }

    mobileBtn?.addEventListener('click', openMobile);
    backdrop?.addEventListener('click', closeMobile);

    function toggleDesktop() {
      const isCollapsed = sidebar?.classList.contains('collapsed');
      if (isCollapsed) {
        // Expand
        sidebar?.classList.remove('md:w-20', 'lg:w-20', 'collapsed');
        sidebar?.classList.add('md:w-64', 'lg:w-64');
        if (toggleIcon) toggleIcon.textContent = 'chevron_left';
        localStorage.setItem('sidebar-collapsed', 'false');
      } else {
        // Collapse
        sidebar?.classList.remove('md:w-64', 'lg:w-64');
        sidebar?.classList.add('md:w-20', 'lg:w-20', 'collapsed');
        if (toggleIcon) toggleIcon.textContent = 'chevron_right';
        localStorage.setItem('sidebar-collapsed', 'true');
      }
    }

    desktopBtn?.addEventListener('click', toggleDesktop);

    // Initial load state from localStorage (run once)
    const storedState = localStorage.getItem('sidebar-collapsed');

    // Check screen width for tablet default (if lg then >1024px)
    const isTablet = window.innerWidth >= 768 && window.innerWidth < 1024;

    if (storedState === 'true' || (isTablet && storedState !== 'false')) {
      sidebar?.classList.remove('md:w-64', 'lg:w-64');
      sidebar?.classList.add('md:w-20', 'lg:w-20', 'collapsed');
      if (toggleIcon) toggleIcon.textContent = 'chevron_right';
    } else {
      sidebar?.classList.remove('md:w-20', 'lg:w-20', 'collapsed');
      sidebar?.classList.add('md:w-64', 'lg:w-64');
      if (toggleIcon) toggleIcon.textContent = 'chevron_left';
    }
  }

  // Run setup once script loads
  setupSidebar();

  // Re-run on View Transitions if enabled
  document.addEventListener('astro:page-load', setupSidebar);
</script>

<style is:global>
  @media (min-width: 768px) {
    #app-sidebar.collapsed .sidebar-text {
      opacity: 0;
      width: 0;
      pointer-events: none;
      visibility: hidden;
    }
  }
</style>
