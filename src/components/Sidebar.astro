---
import SidebarFooter from './SidebarFooter.astro';
import SidebarHeader from './SidebarHeader.astro';

const navItems = [
  { icon: 'smart_toy', label: 'Results Bot', href: '/' },
  { icon: 'diamond', label: 'My Predictions', href: '/predictions' },
  { icon: 'leaderboard', label: 'Leaderboard', href: '/leaderboard' },
  { icon: 'analytics', label: 'Stats & Insights', href: '/stats' },
];

const currentPath = new URL(Astro.request.url).pathname;

// TODO: fix popping out sidebar on page load if user has it collapsed
---

<!-- Sidebar Navigation -->
<aside
  id="app-sidebar"
  class="fixed md:relative inset-y-0 left-0 z-50 w-64 md:w-64 lg:w-64 border-r border-slate-200 dark:border-border-dark bg-white dark:bg-background-dark flex flex-col h-screen transform -translate-x-full md:translate-x-0 shrink-0"
>
  <button
    type="button"
    id="desktop-sidebar-toggle"
    class="absolute -right-3 top-13 bg-white dark:bg-surface-dark border border-slate-200 dark:border-border-dark rounded-full w-6 h-6 flex items-center justify-center text-slate-500 hover:text-primary z-50 drop-shadow-sm hidden md:flex cursor-pointer transition-transform"
  >
    <span class="material-symbols-outlined text-[14px]">chevron_left</span>
  </button>

  <SidebarHeader />

  <nav class="flex-1 px-3 space-y-1 mt-4 overflow-y-auto overflow-x-hidden">
    {navItems.map((item) => (
        <a
          class={`flex items-center gap-4 px-4 py-3 rounded-lg group whitespace-nowrap ${
            currentPath === item.href
              ? 'bg-primary/10 text-primary'
              : 'text-slate-600 dark:text-muted-dark hover:bg-slate-100 dark:hover:bg-surface-dark transition-colors'
          }`}
          href={item.href}
          title={item.label}
        >
          <span class="material-symbols-outlined shrink-0">{item.icon}</span>
          <span class="sidebar-text font-medium opacity-100 origin-left">
            {item.label}
          </span>
        </a>
      ))}
  </nav>

  <SidebarFooter />
</aside>

<!-- Inline script runs exactly here to immediately synchronize state natively prior to DOM render paint -->
<script is:inline>
(() => {
  const sidebar = document.getElementById('app-sidebar');
  const toggle = document.getElementById('desktop-sidebar-toggle');
  const icon = toggle?.querySelector('span');
  if (!sidebar) return;

  const storedState = localStorage.getItem('sidebar-collapsed');
  const isTablet = window.innerWidth >= 768 && window.innerWidth < 1024;

  if (storedState === 'true' || (isTablet && storedState !== 'false')) {
    sidebar.classList.remove('md:w-64', 'lg:w-64');
    sidebar.classList.add('md:w-20', 'lg:w-20', 'collapsed');
    if (icon) icon.textContent = 'chevron_right';
  } else {
    sidebar.classList.remove('md:w-20', 'lg:w-20', 'collapsed');
    sidebar.classList.add('md:w-64', 'lg:w-64');
    if (icon) icon.textContent = 'chevron_left';
  }
})();
</script>

<!-- Mobile Backdrop -->
<div
  id="sidebar-backdrop"
  class="fixed inset-0 bg-slate-900/50 z-40 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
></div>

<script>
// Global click delegation for sidebar toggles
document.addEventListener('click', (e) => {
  if (!(e.target instanceof Element)) return;
  const btn = e.target.closest(
    '#desktop-sidebar-toggle, #mobile-sidebar-toggle, #sidebar-backdrop',
  );
  if (!btn) return;

  const sidebar = document.getElementById('app-sidebar');
  const backdrop = document.getElementById('sidebar-backdrop');
  if (!sidebar) return;

  if (btn.id === 'desktop-sidebar-toggle') {
    const isCollapsed = !sidebar.classList.contains('collapsed');
    localStorage.setItem('sidebar-collapsed', isCollapsed);

    // Toggle width classes
    sidebar.classList.toggle('md:w-64', !isCollapsed);
    sidebar.classList.toggle('lg:w-64', !isCollapsed);
    sidebar.classList.toggle('md:w-20', isCollapsed);
    sidebar.classList.toggle('lg:w-20', isCollapsed);
    sidebar.classList.toggle('collapsed', isCollapsed);

    // Toggle icon
    const icon = btn.querySelector('span');
    if (icon) icon.textContent = isCollapsed ? 'chevron_right' : 'chevron_left';
  } else if (btn.id === 'mobile-sidebar-toggle') {
    sidebar.classList.remove('-translate-x-full');
    backdrop?.classList.remove('opacity-0', 'pointer-events-none');
  } else if (btn.id === 'sidebar-backdrop') {
    sidebar.classList.add('-translate-x-full');
    backdrop?.classList.add('opacity-0', 'pointer-events-none');
  }
});

// Re-enable CSS transitions safely after first paint and on page-loads
document.addEventListener('astro:page-load', () => {
  const sidebar = document.getElementById('app-sidebar');
  if (!sidebar) return;
  setTimeout(() => {
    sidebar.classList.add('transition-all', 'duration-300');
    sidebar.querySelectorAll('.sidebar-text').forEach((t) => {
      t.classList.add('transition-opacity', 'duration-300');
    });
  }, 50);
});
</script>

<style is:global>
@media (min-width: 768px) {
  #app-sidebar.collapsed .sidebar-text {
    opacity: 0;
    width: 0;
    pointer-events: none;
    visibility: hidden;
  }
}
</style>
