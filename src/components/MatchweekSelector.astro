---
interface Props {
  matchweek: number;
  startDate: string;
  endDate: string;
}

const { matchweek, startDate, endDate } = Astro.props;

const formatDate = (dateString: string) => {
  const date = new Date(dateString);
  return date.toLocaleDateString('en-GB', {
    weekday: 'short',
    day: 'numeric',
    month: 'short',
  });
};
---

<script>
import { $gameweek } from '@/stores/gameweek';
import { $gameweekData } from '@/stores/gameweekData';

const display = document.getElementById('gw-display');

const formatDate = (dateString: string) => {
  const date = new Date(dateString);
  return date.toLocaleDateString('en-GB', {
    weekday: 'short',
    day: 'numeric',
    month: 'short',
  });
};

$gameweek.subscribe((gw) => {
  if (!display) return;
  display.textContent = `${gw}`;
});

$gameweekData.listen((data) => {
  if (!data) return;

  const startDateEl = document.getElementById('start-date');
  const endDateEl = document.getElementById('end-date');
  const { start, end } = data.dateRange;

  if (startDateEl && endDateEl) {
    startDateEl.textContent = formatDate(start);
    endDateEl.textContent = formatDate(end);
  }
});

document.getElementById('prev-gw')?.addEventListener('click', () => {
  $gameweek.set($gameweek.get() - 1);
});

document.getElementById('next-gw')?.addEventListener('click', () => {
  $gameweek.set($gameweek.get() + 1);
});
</script>

<div class="flex items-center gap-4 md:gap-6 bg-transparent">
  <button
    type="button"
    id="prev-gw"
    class="w-8 h-8 md:w-10 md:h-10 flex items-center justify-center rounded-full bg-slate-200 dark:bg-surface-dark/50 hover:bg-slate-300 dark:hover:bg-border-dark transition-colors text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary/50"
    aria-label="Previous Matchweek"
  >
    <span class="material-symbols-outlined text-lg md:text-xl"
      >chevron_left</span
    >
  </button>

  <div
    class="flex flex-col items-center justify-center min-w-[120px] md:min-w-[160px]"
  >
    <span
      class="text-base md:text-xl font-bold tracking-tight text-slate-900 dark:text-white"
    >
      Matchweek <span id="gw-display">{matchweek}</span>
    </span>
    <span class="text-[11px] md:text-sm text-slate-500 dark:text-muted-dark">
      <span id="start-date">{formatDate(startDate)}</span>
      - <span id="end-date">{formatDate(endDate)}</span>
    </span>
  </div>

  <button
    id="next-gw"
    type="button"
    class="w-8 h-8 md:w-10 md:h-10 flex items-center justify-center rounded-full bg-slate-200 dark:bg-surface-dark/50 hover:bg-slate-300 dark:hover:bg-border-dark transition-colors text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary/50"
    aria-label="Next Matchweek"
  >
    <span class="material-symbols-outlined text-lg md:text-xl"
      >chevron_right</span
    >
  </button>
</div>
