---
import '@/styles/globals.css';
import MainLayout from '@/components/MainLayout.astro';
import PageWrapper from '@/components/PageWrapper.astro';

// In a real implementation this would fetch from locals or a user store
const user = (Astro.locals as any).user || { name: 'Demo User', email: 'demo@example.com' };

const pageSubtitle = "Your Prediction Analysis and Virtual Trophy Cabinet.";

// Mock data
const mockStats = {
  totalPoints: 1245,
  exactScores: 32,
  correctOutcomes: 85,
  theSpecialist: { league: 'Premier League', accuracy: '68%' },
  recentForm: ['W', 'D', 'W', 'W', 'L'], // W = Green, D = Gray, L = Red
  favoriteTeam: 'Arsenal'
};
---

<PageWrapper title="User Profile | Results Bot">
  <MainLayout pageTitle="Prediction Profile" pageSubtitle={pageSubtitle}>
    {/* Layout grid for profile sections */}
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 pb-12">

      <!-- User Info & Favorite Team -->
      <div class="md:col-span-12 flex flex-col sm:flex-row items-start sm:items-center justify-between bg-white dark:bg-surface-dark border border-slate-200 dark:border-border-dark rounded-2xl p-6 shadow-sm">
        <div class="flex items-center gap-5">
          <div class="w-16 h-16 rounded-full bg-primary/10 flex flex-col items-center justify-center shrink-0 border border-primary/30 relative">
            <span class="material-symbols-outlined text-primary text-3xl">sports_soccer</span>
            <div class="absolute -bottom-1 -right-1 bg-emerald-500 w-4 h-4 rounded-full border-2 border-white dark:border-surface-dark"></div>
          </div>
          <div>
            <h2 class="text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-3">
              {user.name}
              <span class="text-[10px] bg-yellow-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-500 px-2 py-0.5 rounded-full font-bold uppercase tracking-wider border border-yellow-200 dark:border-yellow-700/50">Pro</span>
            </h2>
            <p class="text-sm text-slate-500 dark:text-muted-dark font-medium">{user.email}</p>
          </div>
        </div>

        <div class="mt-6 sm:mt-0 items-start sm:items-end flex flex-col">
            <span class="text-xs text-slate-500 dark:text-muted-dark font-semibold uppercase tracking-wider mb-2">Favorite Team</span>
            <button class="flex items-center gap-2 px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm font-semibold rounded-xl transition-colors shadow-sm shadow-red-600/20">
              <span class="material-symbols-outlined text-[18px]">shield</span>
              {mockStats.favoriteTeam}
            </button>
            <span class="text-[10px] text-slate-400 dark:text-slate-500 mt-2 flex items-center gap-1">
                <span class="material-symbols-outlined text-[12px]">palette</span> Affects UI accents
            </span>
        </div>
      </div>

      <!-- Stats Overview -->
      <div class="md:col-span-8 grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-white dark:bg-surface-dark border border-slate-200 dark:border-border-dark rounded-2xl p-6 shadow-sm flex flex-col items-center justify-center text-center">
            <p class="text-[11px] text-slate-500 dark:text-muted-dark font-bold uppercase tracking-wider mb-2 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[16px] text-primary">toll</span> Total Points
            </p>
            <span class="text-4xl font-black text-slate-900 dark:text-white tabular-nums tracking-tight">{mockStats.totalPoints}</span>
        </div>
        <div class="bg-white dark:bg-surface-dark border border-slate-200 dark:border-border-dark rounded-2xl p-6 shadow-sm flex flex-col items-center justify-center text-center">
            <p class="text-[11px] text-emerald-600 dark:text-emerald-500 font-bold uppercase tracking-wider mb-1 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[16px]">my_location</span> Exact Scores
            </p>
            <span class="text-3xl font-bold text-slate-900 dark:text-white tabular-nums my-1">{mockStats.exactScores}</span>
            <p class="text-[10px] font-medium text-slate-400 uppercase tracking-wide">Spot on checks</p>
        </div>
         <div class="bg-white dark:bg-surface-dark border border-slate-200 dark:border-border-dark rounded-2xl p-6 shadow-sm flex flex-col items-center justify-center text-center">
            <p class="text-[11px] text-blue-600 dark:text-blue-500 font-bold uppercase tracking-wider mb-1 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[16px]">check_circle</span> Outcomes
            </p>
            <span class="text-3xl font-bold text-slate-900 dark:text-white tabular-nums my-1">{mockStats.correctOutcomes}</span>
            <p class="text-[10px] font-medium text-slate-400 uppercase tracking-wide">Right W/D/L pick</p>
        </div>
      </div>

       <!-- Form Guide -->
       <div class="md:col-span-4 bg-white dark:bg-surface-dark border border-slate-200 dark:border-border-dark rounded-2xl p-6 shadow-sm flex flex-col justify-center">
        <div class="flex items-center justify-between mb-5">
            <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider">Recent Form</h3>
            <span class="text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Last 5</span>
        </div>
        <div class="flex items-center justify-between gap-2 lg:gap-3">
            {mockStats.recentForm.map(f => (
                <div class={`w-10 h-10 lg:w-11 lg:h-11 rounded-xl flex items-center justify-center font-bold text-white shadow-sm ${
                    f === 'W' ? 'bg-emerald-500 shadow-emerald-500/20' :
                    f === 'D' ? 'bg-slate-400 dark:bg-slate-600' : 'bg-red-500 shadow-red-500/20'
                }`}>
                    {f}
                </div>
            ))}
        </div>
      </div>

      <!-- The Specialist -->
      <div class="md:col-span-12 bg-gradient-to-r from-primary/10 to-transparent dark:from-primary/20 dark:to-transparent border border-primary/20 dark:border-primary/30 rounded-2xl p-6 shadow-sm flex flex-col sm:flex-row sm:items-center gap-6 relative overflow-hidden">
        <!-- Decoration background -->
        <span class="material-symbols-outlined absolute -right-6 -bottom-8 text-9xl text-primary/5 dark:text-primary/10 -rotate-12 pointer-events-none">military_tech</span>

        <div class="w-16 h-16 rounded-2xl bg-primary flex items-center justify-center shadow-lg shadow-primary/30 shrink-0 transform -rotate-6">
            <span class="material-symbols-outlined text-white text-3xl">military_tech</span>
        </div>
        <div class="flex-1">
            <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
                The Specialist
            </h3>
            <p class="text-sm text-slate-600 dark:text-slate-300 font-medium mt-1">{mockStats.theSpecialist.league} Expert</p>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Based on historical correct outcome ratio.</p>
        </div>
        <div class="sm:text-right mt-4 sm:mt-0 bg-white dark:bg-surface-dark sm:bg-transparent sm:dark:bg-transparent p-4 sm:p-0 rounded-xl sm:rounded-none border sm:border-none border-slate-200 dark:border-border-dark">
            <span class="block text-3xl font-black text-primary tabular-nums tracking-tighter">{mockStats.theSpecialist.accuracy}</span>
            <span class="text-[10px] font-bold text-slate-500 dark:text-muted-dark uppercase tracking-widest block mt-1">Accuracy</span>
        </div>
      </div>

      <!-- Beat the Bot -->
      <div class="md:col-span-12 bg-slate-900 dark:bg-black border border-slate-800 dark:border-slate-800 rounded-2xl p-6 shadow-xl flex flex-col sm:flex-row sm:items-center gap-6 relative overflow-hidden">
        <!-- Decoration background -->
        <span class="material-symbols-outlined absolute -right-6 -bottom-8 text-9xl text-white/5 dark:text-white/5 -rotate-12 pointer-events-none">smart_toy</span>
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center shadow-lg shadow-indigo-500/30 shrink-0 transform rotate-3">
            <span class="material-symbols-outlined text-white text-3xl">smart_toy</span>
        </div>
        <div class="flex-1 z-10">
            <h3 class="text-lg font-bold text-white flex items-center gap-2">
                Beat the Bot Record
            </h3>
            <p class="text-sm text-slate-400 font-medium mt-1">Head-to-Head: You vs. Results Bot</p>
            <p class="text-xs text-slate-500 mt-1">Compare your performance against our algorithm.</p>
        </div>

        <div class="w-full sm:w-auto mt-4 sm:mt-0 flex gap-4 justify-center sm:justify-end z-10">
            <div class="text-center bg-slate-800 rounded-xl p-3 min-w-[80px] border border-slate-700 shadow-inner">
                <span class="block text-2xl font-black text-emerald-400 tabular-nums">42</span>
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-1 block">WINS</span>
            </div>
            <div class="text-center bg-slate-800 rounded-xl p-3 min-w-[80px] border border-slate-700 shadow-inner">
                <span class="block text-2xl font-black text-slate-400 tabular-nums">14</span>
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-1 block">DRAWS</span>
            </div>
            <div class="text-center bg-slate-800 rounded-xl p-3 min-w-[80px] border border-slate-700 shadow-inner relative overflow-hidden">
                <div class="absolute inset-0 bg-red-500/10 hidden"></div>
                <span class="block text-2xl font-black text-red-400 tabular-nums">29</span>
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-1 block">LOSSES</span>
            </div>
        </div>
      </div>

      <!-- Virtual Trophy Cabinet -->
      <div class="md:col-span-12 bg-white dark:bg-surface-dark border border-slate-200 dark:border-border-dark rounded-2xl p-6 sm:p-8 shadow-sm">
        <div class="flex items-center gap-3 mb-8">
            <span class="material-symbols-outlined text-yellow-500 text-3xl">emoji_events</span>
            <div>
              <h3 class="text-xl font-bold text-slate-900 dark:text-white">Virtual Trophy Cabinet</h3>
              <p class="text-sm text-slate-500 mt-1">Achievements unlocked across your prediction career.</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Trophy 1 -->
            <div class="relative overflow-hidden border border-yellow-200 dark:border-yellow-900/50 bg-yellow-50/50 dark:bg-yellow-900/10 rounded-2xl p-5 flex flex-col gap-4 group hover:shadow-md transition-shadow">
                <div class="w-14 h-14 rounded-full bg-gradient-to-br from-yellow-300 to-yellow-600 flex items-center justify-center shrink-0 shadow-md shadow-yellow-500/20 border-2 border-yellow-100 dark:border-yellow-900 group-hover:scale-110 transition-transform duration-300">
                    <span class="material-symbols-outlined text-white text-2xl">workspace_premium</span>
                </div>
                <div>
                    <h4 class="font-bold text-slate-900 dark:text-white text-base">The Centurion</h4>
                    <p class="text-xs text-slate-600 dark:text-slate-400 mt-1.5 leading-relaxed">Hit 100 correct predictions across all leagues.</p>
                </div>
            </div>

            <!-- Trophy 2 (Locked) -->
             <div class="relative overflow-hidden border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/30 rounded-2xl p-5 flex flex-col gap-4 group opacity-70">
                <div class="w-14 h-14 rounded-full bg-slate-200 dark:bg-slate-700 flex items-center justify-center shrink-0 border border-slate-300 dark:border-slate-600 grayscale">
                    <span class="material-symbols-outlined text-slate-400 dark:text-slate-500 text-2xl">timer</span>
                </div>
                <div>
                    <h4 class="font-bold text-slate-500 dark:text-slate-400 text-base">Last Minute Hero</h4>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1.5 leading-relaxed">Correctly predict a result that changes after the 80th minute.</p>
                    <span class="inline-flex items-center gap-1.5 bg-slate-200 dark:bg-slate-800 px-2.5 py-1 rounded-md text-[10px] font-bold text-slate-500 mt-3 uppercase tracking-wider"><span class="material-symbols-outlined text-[12px] align-middle">lock</span> Locked</span>
                </div>
            </div>

            <!-- Trophy 3 -->
             <div class="relative overflow-hidden border border-purple-200 dark:border-purple-900/50 bg-purple-50/50 dark:bg-purple-900/10 rounded-2xl p-5 flex flex-col gap-4 group hover:shadow-md transition-shadow">
                <div class="w-14 h-14 rounded-full bg-gradient-to-br from-purple-400 to-purple-600 flex items-center justify-center shrink-0 shadow-md shadow-purple-500/20 border-2 border-purple-200 dark:border-purple-900 group-hover:-rotate-12 transition-transform duration-300">
                    <span class="material-symbols-outlined text-white text-2xl">trending_up</span>
                </div>
                <div>
                    <h4 class="font-bold text-slate-900 dark:text-white text-base">Underdog Specialist</h4>
                    <p class="text-xs text-slate-600 dark:text-slate-400 mt-1.5 leading-relaxed">Predicted a win for a team with &lt;20% pre-match calculated probability.</p>
                </div>
            </div>
        </div>
      </div>

    </div>
  </MainLayout>
</PageWrapper>
