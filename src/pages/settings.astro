---
import MainLayout from '@/components/MainLayout.astro';
import PageWrapper from '@/components/PageWrapper.astro';

const pageSubtitle = 'Manage your matchday preferences and privacy.';
---

<PageWrapper title="Settings | Results Bot">
  <MainLayout pageTitle="Settings" pageSubtitle={pageSubtitle}>
    <div class="max-w-3xl mx-auto space-y-8 pb-12">
      <!-- Matchday Preferences -->
      <section
        class="bg-white dark:bg-surface-dark border border-slate-200 dark:border-border-dark rounded-2xl p-6 md:p-8 shadow-sm"
      >
        <div
          class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100 dark:border-slate-800/50"
        >
          <span class="material-symbols-outlined text-primary text-2xl">tune</span>
          <h2 class="text-xl font-bold text-slate-900 dark:text-white">Matchday Preferences</h2>
        </div>

        <div class="space-y-6">
          <!-- Notification "Kick-off" Alerts -->
          <div class="flex items-start justify-between gap-4">
            <div>
              <h3
                class="text-base font-semibold text-slate-900 dark:text-white flex items-center gap-2"
              >
                Kick-off Alerts
                <span class="material-symbols-outlined text-sm text-yellow-500"
                  >notifications_active</span
                >
              </h3>
              <p class="text-sm text-slate-500 dark:text-muted-dark mt-1">
                Ping me 30 mins before kick-off if I haven't entered my prediction.
              </p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer shrink-0 mt-1">
              <input type="checkbox" value="" class="sr-only peer" checked>
              <div
                class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-slate-600 peer-checked:bg-primary"
              ></div>
            </label>
          </div>

          <!-- The Final Whistle -->
          <div
            class="flex items-start justify-between gap-4 pt-4 border-t border-slate-100 dark:border-slate-800/50"
          >
            <div>
              <h3
                class="text-base font-semibold text-slate-900 dark:text-white flex items-center gap-2"
              >
                The Final Whistle
                <span class="material-symbols-outlined text-sm text-emerald-500">sports</span>
              </h3>
              <p class="text-sm text-slate-500 dark:text-muted-dark mt-1">
                Alert me immediately when a match ends to show my points.
              </p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer shrink-0 mt-1">
              <input type="checkbox" value="" class="sr-only peer" checked>
              <div
                class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-slate-600 peer-checked:bg-primary"
              ></div>
            </label>
          </div>

          <!-- Prediction Logic Defaults -->
          <div
            class="flex items-start justify-between gap-4 pt-4 border-t border-slate-100 dark:border-slate-800/50"
          >
            <div>
              <h3 class="text-base font-semibold text-slate-900 dark:text-white">
                Auto-fill Default Prediction
              </h3>
              <p class="text-sm text-slate-500 dark:text-muted-dark mt-1">
                Always default my predictions to a 1-0 Home Win.
              </p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer shrink-0 mt-1">
              <input type="checkbox" value="" class="sr-only peer">
              <div
                class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-slate-600 peer-checked:bg-primary"
              ></div>
            </label>
          </div>

          <!-- Odds Display -->
          <div
            class="flex items-start justify-between gap-4 pt-4 border-t border-slate-100 dark:border-slate-800/50"
          >
            <div>
              <h3 class="text-base font-semibold text-slate-900 dark:text-white">
                Display Betting Odds
              </h3>
              <p class="text-sm text-slate-500 dark:text-muted-dark mt-1">
                Show odds to help predict. Turn off to avoid gambling triggers or distractions.
              </p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer shrink-0 mt-1">
              <input type="checkbox" value="" class="sr-only peer">
              <div
                class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-slate-600 peer-checked:bg-primary"
              ></div>
            </label>
          </div>
        </div>
      </section>

      <!-- Privacy / Social Toggles -->
      <section
        class="bg-white dark:bg-surface-dark border border-slate-200 dark:border-border-dark rounded-2xl p-6 md:p-8 shadow-sm"
      >
        <div
          class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100 dark:border-slate-800/50"
        >
          <span class="material-symbols-outlined text-primary text-2xl">admin_panel_settings</span>
          <h2 class="text-xl font-bold text-slate-900 dark:text-white">Privacy & Social</h2>
        </div>

        <div class="space-y-6">
          <!-- Incognito Mode -->
          <div class="flex items-start justify-between gap-4">
            <div>
              <h3
                class="text-base font-semibold text-slate-900 dark:text-white flex items-center gap-2"
              >
                Incognito Mode
                <span class="material-symbols-outlined text-sm text-slate-500">visibility_off</span>
              </h3>
              <p class="text-sm text-slate-500 dark:text-muted-dark mt-1">
                Hide my predictions from the global leaderboard until the match starts (prevents
                copying).
              </p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer shrink-0 mt-1">
              <input type="checkbox" value="" class="sr-only peer" checked>
              <div
                class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer dark:bg-slate-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-slate-600 peer-checked:bg-primary"
              ></div>
            </label>
          </div>

          <!-- Global vs. Friends -->
          <div
            class="flex items-start justify-between gap-4 pt-4 border-t border-slate-100 dark:border-slate-800/50"
          >
            <div class="w-full">
              <h3 class="text-base font-semibold text-slate-900 dark:text-white">
                Competition Scope
              </h3>
              <p class="text-sm text-slate-500 dark:text-muted-dark mt-1 mb-4">
                Choose who you want to compete against in the leaderboards.
              </p>

              <div class="grid grid-cols-2 gap-3">
                <label class="cursor-pointer">
                  <input type="radio" name="scope" class="peer sr-only" checked>
                  <div
                    class="p-4 rounded-xl border-2 border-slate-200 dark:border-border-dark peer-checked:border-primary peer-checked:bg-primary/5 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors text-center"
                  >
                    <span
                      class="material-symbols-outlined mb-2 text-slate-600 dark:text-slate-400 peer-checked:text-primary block mx-auto text-2xl"
                      >public</span
                    >
                    <span class="font-bold text-slate-900 dark:text-white block text-sm"
                      >Global</span
                    >
                    <span
                      class="text-[10px] text-slate-500 dark:text-muted-dark uppercase tracking-wider block mt-1"
                      >Everyone</span
                    >
                  </div>
                </label>

                <label class="cursor-pointer">
                  <input type="radio" name="scope" class="peer sr-only">
                  <div
                    class="p-4 rounded-xl border-2 border-slate-200 dark:border-border-dark peer-checked:border-primary peer-checked:bg-primary/5 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors text-center"
                  >
                    <span
                      class="material-symbols-outlined mb-2 text-slate-600 dark:text-slate-400 peer-checked:text-primary block mx-auto text-2xl"
                      >group</span
                    >
                    <span class="font-bold text-slate-900 dark:text-white block text-sm"
                      >Friends Only</span
                    >
                    <span
                      class="text-[10px] text-slate-500 dark:text-muted-dark uppercase tracking-wider block mt-1"
                      >Private Leagues</span
                    >
                  </div>
                </label>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </MainLayout>
</PageWrapper>
