---
import '@/styles/globals.css';
import DateGroup from '@/components/ResultsTable/DateGroup.astro';
import MainLayout from '@/components/MainLayout.astro';
import MatchweekSelector from '@/components/MatchweekSelector.astro';
import PageWrapper from '@/components/PageWrapper.astro';
import TableDate from '@/components/TableDate.astro';
import mockOdds from '@/mocks/premier-league-games.json';
import { $currentGameweek } from '@/stores/store';
import { fixtureByDates, fixtureDates } from '@/helpers/sort-games-by-date';
import { getLatestOdds } from '@/helpers/get-latest-odds';
import { getPredictionPoints } from '@/helpers/get-predicition-points';
import { mergeFixturesWithPredictions } from '@/helpers/merge-fixtures-predictions';
import { predictScores } from '@/helpers/prediction-engine';

import { GET as getFixtures } from './api/fixtures';

const USE_MOCK_DATA = true;

let response = await getFixtures(Astro);
const { fixtures, gameweekDateRange } = await response.json();

const odds = USE_MOCK_DATA
  ? mockOdds
  : await getLatestOdds(gameweekDateRange.earliest, gameweekDateRange.latest);
const predictions = predictScores(odds as any);
const fullFixtureData = mergeFixturesWithPredictions(fixtures, predictions);

const fixturesWithScores = fullFixtureData.map((f) => ({
  ...f,
  points: getPredictionPoints(
    { home: f.predictedScoreHome, away: f.predictedScoreAway },
    { home: f.finalScore?.homeTeam ?? 0, away: f.finalScore?.awayTeam ?? 0 },
  ),
}));

const fixturesByDate = fixtureByDates(fixturesWithScores);
const sortedFixtures = fixtureDates(fixturesByDate);
---

<PageWrapper title="Beat the Bot: EPL Predictions">
  <MainLayout
    pageTitle="Results Bot Predictions"
    pageSubtitle="The bot has made its predictions for this gameweek"
  >
    <div slot="titleActions" class="flex items-center gap-2">
      <MatchweekSelector
        matchweek={$currentGameweek.get()}
        startDate={gameweekDateRange.earliest}
        endDate={gameweekDateRange.latest}
      />
    </div>
    <div class="space-y-6 pb-20">
      {
        sortedFixtures.map((date) => (
          <section class="space-y-3">
            <TableDate date={date} />
            <DateGroup games={fixturesByDate[date]} />
          </section>
        ))
      }
    </div>
  </MainLayout>
</PageWrapper>
