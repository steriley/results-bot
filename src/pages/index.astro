---
import { isPast } from 'date-fns/isPast';
import GameWeekSelector from '@/components/GameWeekSelector.vue';
import MainLayout from '@/components/MainLayout.astro';
import PageWrapper from '@/components/PageWrapper.astro';
import ResultsTable from '@/components/ResultsTable/ResultsTable.vue';
import { GET as getFixtures } from './api/fixtures';

let response = await getFixtures(Astro);
const { dateRange, gameWeek, totalPoints, groupedFixtures } = await response.json();
const { start, end } = dateRange;

const pageSubtitle = isPast(start)
  ? `The bot has made its predictions for gameweek ${gameWeek}`
  : `The bot is calculating its predictions for gameweek ${gameWeek}`;
---

<PageWrapper title="Beat the Bot: EPL Predictions">
  <MainLayout pageTitle="Results Bot Predictions" pageSubtitle={pageSubtitle}>
    <div slot="titleActions" class="flex items-center gap-2">
      <GameWeekSelector gameWeek={gameWeek} startDate={start} endDate={end} client:load />
    </div>
    <ResultsTable
      gameWeek={gameWeek}
      groupedFixtures={groupedFixtures}
      totalPoints={totalPoints}
      client:load
    />
  </MainLayout>
</PageWrapper>
