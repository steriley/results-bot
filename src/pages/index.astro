---
import '../styles/globals.css';
import DateGroup from '../components/DateGroup.astro';
import MatchweekSelector from '../components/MatchweekSelector.astro';
import MainLayout from '../components/MainLayout.astro';
import PageWrapper from '../components/PageWrapper.astro';
import { getLatestOdds } from '../helpers/get-latest-odds';
import { predictScores } from '../helpers/prediction-engine';
import mockData from '../mocks/premier-league-games.json';
// import { getGameweekFixtures } from '../helpers/gameweek';

const USE_MOCK_DATA = true;
const odds = USE_MOCK_DATA
  ? mockData
  : await getLatestOdds('2026-02-21T15:00:00Z', '2026-02-23T20:00:00Z');
const scores = predictScores(odds as any);

// const fixtures = await getGameweekFixtures(27);

// Group games by date
const gamesByDate = scores.reduce(
  (acc, game) => {
    const date = new Date(game.commenceTime);
    const dateKey = date.toLocaleDateString('en-GB', {
      weekday: 'long',
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    });

    if (!acc[dateKey]) {
      acc[dateKey] = [];
    }
    acc[dateKey].push(game);
    return acc;
  },
  {} as Record<string, typeof scores>,
);

// Sort dates chronologically
const sortedDates = Object.keys(gamesByDate).sort((a, b) => {
  return new Date(a).getTime() - new Date(b).getTime();
});
---

<PageWrapper title="Results Bot | Premier League Dashboard">
  <MainLayout
    pageTitle="Results Bot Predictions"
    pageSubtitle="Gameweek 27 • 21 Feb - 23 Feb"
  >
    <div slot="titleActions" class="flex items-center gap-2">
      <MatchweekSelector matchweek={27} dateRange="Sat 21 Feb - Mon 23 Feb" />
    </div>
    <div class="space-y-6 pb-20">
      {
        sortedDates.map((date) => (
          <DateGroup date={date} games={gamesByDate[date]} />
        ))
      }
    </div>
  </MainLayout>
</PageWrapper>
