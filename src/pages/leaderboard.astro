---
import AnalysisAvailable from '@/components/Leaderboard/AnalysisAvailable.astro';
import GlobalRank from '@/components/Leaderboard/GlobalRank.astro';
import LeaderTable from '@/components/Leaderboard/LeaderTable.astro';
import RobotRank from '@/components/Leaderboard/RobotRank.astro';
import TotalParticipants from '@/components/Leaderboard/TotalParticipants.astro';
import MainLayout from '@/components/MainLayout.astro';
import PageWrapper from '@/components/PageWrapper.astro';
import { getActiveEvent } from '@/db/model/Bootstrap.model';
import { getLeagueTable } from '@/db/services/LeagueTable.service';
import { getTimeRemaining } from '@/helpers/date-countdown';

const activeEvent = await getActiveEvent();
const ending = getTimeRemaining(new Date(activeEvent.nextDeadline));
const pageSubtitle = `Season ${activeEvent.season} • Round ${activeEvent.gameWeek} • ${ending}`;

const table = await getLeagueTable({ timeFilter: 'all-time', sortBy: 'totalPoints' });

console.log(JSON.stringify(table, null, 2));
---

<PageWrapper title="Results Bot | Premier League Dashboard">
  <MainLayout pageTitle="Predictions League" pageSubtitle={pageSubtitle}>
    <div slot="titleActions" class="flex items-center gap-2">
      <a
        href="/predictions"
        class="flex items-center gap-2 bg-primary text-white px-5 py-2.5 rounded-lg font-bold text-sm hover:bg-primary/90 transition-all shadow-lg shadow-primary/20"
      >
        <span class="material-symbols-outlined text-[20px]">add_circle</span>
        Make Predictions
      </a>
      <a
        href="/league-rules"
        class="flex items-center gap-2 bg-slate-100 dark:bg-border-dark text-slate-700 dark:text-slate-200 px-5 py-2.5 rounded-lg font-bold text-sm hover:bg-slate-200 dark:hover:bg-border-dark transition-all"
      >
        <span class="material-symbols-outlined text-[20px]">rule</span>
        League Rules
      </a>
    </div>

    <!-- Score Overview Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
      <TotalParticipants />
      <RobotRank />
      <GlobalRank />
    </div>
    <LeaderTable />
    <AnalysisAvailable />
  </MainLayout>
</PageWrapper>
