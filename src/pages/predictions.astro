---
import '../styles/globals.css';
import DateGroup from '../components/DateGroup.astro';
import MainLayout from '../components/MainLayout.astro';
import PageWrapper from '../components/PageWrapper.astro';
import mockUserPredictions from '../mocks/gameweek_27_user_1.json';
import mockGameweekFixtures from '../mocks/gameweek_27.json';
import { getGameweekFixtures } from '../helpers/gameweek';
import QuickStats from '../components/QuickStats.astro';

const USE_MOCK_DATA = true;

const fixtures = USE_MOCK_DATA
  ? mockGameweekFixtures
  : await getGameweekFixtures(27);

const userPredictions = mockUserPredictions;
const scores = fixtures.map((fixture) => {
  const userPrediction = userPredictions.find(
    (prediction) =>
      prediction.homeTeam === fixture.homeTeam &&
      prediction.awayTeam === fixture.awayTeam,
  );
  return {
    ...fixture,
    prediction: {
      mostLikelyScore: {
        home: userPrediction?.homeScore,
        away: userPrediction?.awayScore,
      },
    },
  };
});

console.log(JSON.stringify(scores, null, 2));

// Group games by date
const gamesByDate = scores.reduce(
  (acc, game) => {
    const date = new Date(game.commenceTime ?? Date.now());
    const dateKey = date.toLocaleDateString('en-GB', {
      weekday: 'long',
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    });

    if (!acc[dateKey]) {
      acc[dateKey] = [];
    }
    acc[dateKey].push(game);
    return acc;
  },
  {} as Record<string, typeof scores>,
);

const sortedDates = Object.keys(gamesByDate).sort(
  (a, b) => new Date(a).getTime() - new Date(b).getTime(),
);
---

<PageWrapper title="Results Bot | Predictions">
  <MainLayout
    pageTitle="My Predictions"
    pageSubtitle="Gameweek 27 • Make your score predictions to beat the bot"
  >
    <div slot="titleActions" class="flex items-center gap-2">
      <QuickStats accuracy={14} trending="up" />
    </div>
    <div class="space-y-6 pb-20">
      {
        sortedDates.map((date) => (
          <DateGroup
            date={date}
            games={gamesByDate[date]}
            showUserInputs={true}
          />
        ))
      }
    </div>
  </MainLayout>
  <script type="module" src="/js/score-input.js"></script>
</PageWrapper>
