---
import '@/styles/globals.css';
import DateGroup from '@/components/ResultsTable/DateGroup.astro';
import MainLayout from '@/components/MainLayout.astro';
import PageWrapper from '@/components/PageWrapper.astro';
import QuickStats from '@/components/QuickStats.astro';
import TableDate from '@/components/TableDate.astro';
import mockUserPredictions from '@/mocks/gameweek_27_user_1.json';
import type { EnrichedFixture } from '@/helpers/merge-fixtures-predictions';
import { fixtureByDates, fixtureDates } from '@/helpers/sort-games-by-date';
import { getPredictionPoints } from '@/helpers/get-predicition-points';

import { GET as getFixtures } from './api/fixtures';

const userPredictions = mockUserPredictions;

let response = await getFixtures(Astro);
const { fixtures } = await response.json();

const fullFixtureData = fixtures.map((fixture: EnrichedFixture) => {
  const userPrediction = userPredictions.find(
    (prediction) =>
      prediction.homeTeam === fixture.homeTeam &&
      prediction.awayTeam === fixture.awayTeam,
  );
  return {
    ...fixture,
    predictedScoreHome: userPrediction?.homeScore,
    predictedScoreAway: userPrediction?.awayScore,
    points: getPredictionPoints(
      { home: userPrediction?.homeScore, away: userPrediction?.awayScore },
      {
        home: fixture.finalScore?.homeTeam ?? 0,
        away: fixture.finalScore?.awayTeam ?? 0,
      },
    ),
  };
});

const fixturesByDate = fixtureByDates(fullFixtureData);
const sortedFixtures = fixtureDates(fixturesByDate);
---

<PageWrapper title="Beat the Bot: Your Predictions">
  <MainLayout
    pageTitle="My Predictions"
    pageSubtitle="Gameweek 27 • Make your score predictions to beat the bot"
  >
    <div slot="titleActions" class="flex items-center gap-2">
      <QuickStats accuracy={14} trending="up" />
    </div>
    <div class="space-y-6 pb-20">
      {
        sortedFixtures.map((date) => (
          <section class="space-y-3">
            <TableDate date={date} />
            <DateGroup games={fixturesByDate[date]} showUserInputs={true} />
          </section>
        ))
      }
    </div>
  </MainLayout>
  <script type="module" src="/js/score-input.js"></script>
</PageWrapper>
