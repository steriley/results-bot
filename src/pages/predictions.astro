---
import MainLayout from '@/components/MainLayout.astro';
import PageWrapper from '@/components/PageWrapper.astro';
import QuickStats from '@/components/QuickStats.astro';
import ResultsTable from '@/components/ResultsTable/ResultsTable.vue';
import { $gameweek } from '@/stores/gameweek';

import { GET as getFixtures } from './api/fixtures';

const pageSubtitle = `Gameweek ${$gameweek.value} • Your predictions vs the bot's predictions`;

let response = await getFixtures(Astro);
const { gameWeek, groupedFixtures, totalPoints, accuracy } = await response.json();
---

<PageWrapper title="Beat the Bot: Your Predictions">
  <MainLayout pageTitle="My Predictions" pageSubtitle={pageSubtitle}>
    <div slot="titleActions" class="flex items-center gap-2">
      <QuickStats accuracy={accuracy} trending="up" />
    </div>
    <ResultsTable
      gameWeek={gameWeek}
      groupedFixtures={groupedFixtures}
      totalPoints={totalPoints}
      isInteractive
      client:load
    />
  </MainLayout>
</PageWrapper>
