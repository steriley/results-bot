---
import '@/styles/globals.css';
import PageWrapper from '@/components/PageWrapper.astro';
import MainLayout from '@/components/MainLayout.astro';
import SignInForm from '@/components/SignInForm.vue';
---

<PageWrapper title="Sign In | Results Bot">
  <MainLayout pageTitle="Sign In" pageSubtitle="Sign in to access your command center and personal data.">
    <div class="flex flex-col justify-center items-center py-12 sm:px-6 lg:px-8 w-full mt-8">
      <div class="w-full max-w-md">
        <div class="text-center mb-8">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-primary/10 mb-4 shadow-sm">
            <span class="material-symbols-outlined text-primary text-3xl">smart_toy</span>
          </div>
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Results Bot Auth</h2>
        </div>
        <SignInForm client:load />
      </div>
    </div>
  </MainLayout>
</PageWrapper>
